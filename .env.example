# Required
GCP_PROJECT_ID=your-gcp-project-id
GOOGLE_OAUTH_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-oauth-client-secret
ALLOWED_DOMAIN=yourcompany.com
SERVER_URL=http://localhost:8080
JWT_SECRET=your-jwt-secret-min-32-chars
# NOTE: In production, JWT_SECRET and GOOGLE_OAUTH_CLIENT_SECRET should come
# from Secret Manager (see deploy.sh --set-secrets). Never commit real secrets.

# Optional (defaults shown)
BQ_DATASET=searchconsole
BQ_TABLE=searchdata_url_impression
MAX_BYTES_BILLED=1000000000
TOKEN_TTL_SECONDS=3600
PORT=8080
DATA_AVAILABLE_FROM=2025-02-25
